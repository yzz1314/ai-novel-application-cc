# ============================================
# AI小说创作系统 - 环境配置
# ============================================

# ============= API配置 =============
# 第三方API密钥（必填）
OPENAI_API_KEY=sk-your-openai-or-compatible-api-key
# 第三方API基础URL（如果使用第三方中转，必填）
# 示例：https://api.openai-proxy.com/v1
OPENAI_API_BASE=https://your-api-base.example/v1

# 使用的模型（推荐）
# 高质量：gpt-4
# 低成本：gpt-3.5-turbo（推荐，成本仅为GPT-4的10%）
DEFAULT_MODEL=gpt-4

# 本地联调/端到端测试可开启 mock，避免依赖真实 LLM API
MOCK_LLM=false

# ============= 项目路径配置 =============
PROJECT_BASE_PATH=/workspace
SKILLS_PATH=/workspace/skills

# ============= 性能配置 =============
# 最大分块大小（字符数）
MAX_CHUNK_SIZE=2500

# 分块重叠（字符数）
CHUNK_OVERLAP=200

# 最大并发任务数（建议2-3，避免触发API限流）
MAX_CONCURRENT_TASKS=3

# ============= 日志配置 =============
# 日志级别：DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============= 成本控制（可选）=============
# 每日token使用限制
# DAILY_TOKEN_LIMIT=1000000

# 每日成本限制（美元）
# DAILY_COST_LIMIT=50.0

# ============= 其他LLM配置（可选）=============
# Anthropic Claude
# ANTHROPIC_API_KEY=your-anthropic-key
# DEFAULT_MODEL=claude-3-opus-20240229

# Azure OpenAI
# AZURE_API_KEY=your-azure-key
# AZURE_API_BASE=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2023-05-15
# DEFAULT_MODEL=azure/your-deployment-name

# ============= 说明 =============
# 1. 复制此文件为 .env
# 2. 填入你的API密钥和配置
# 3. 运行 python test_api.py 测试配置
# 4. 启动服务: uvicorn main:app --reload
